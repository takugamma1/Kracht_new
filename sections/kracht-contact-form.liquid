{%- comment -%} Kracht — branded contact form (vanuitkracht.nl style) with contact-person card {%- endcomment -%}

<section class="kracht-contact" style="--kc-pad-y: {{ section.settings.padding_y }}px;">
  <div class="kracht-container kracht-contact__inner">
    <div class="kracht-contact__form-col">
      <h1 class="kracht-contact__title">{{ section.settings.heading }}</h1>
      <p class="kracht-contact__intro">{{ section.settings.intro }}</p>

      {%- form 'contact', class: 'kracht-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="kracht-contact__success">Bedankt voor je bericht! We nemen zo snel mogelijk contact met je op.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="kracht-contact__error">Er ging iets mis. Controleer je gegevens en probeer het opnieuw.</p>
        {%- endif -%}

        <label class="kracht-contact__label" for="kc-category">Categorie*</label>
        <div class="kracht-contact__select-wrap">
          <select id="kc-category" name="contact[categorie]" required class="kracht-contact__field">
            <option value="" disabled selected>Maak een keuze</option>
            {%- assign cats = section.settings.categories | split: ',' -%}
            {%- for cat in cats -%}
              <option value="{{ cat | strip }}">{{ cat | strip }}</option>
            {%- endfor -%}
          </select>
        </div>

        <div class="kracht-contact__row">
          <div>
            <label class="kracht-contact__label" for="kc-fname">Voornaam*</label>
            <input id="kc-fname" type="text" name="contact[voornaam]" required class="kracht-contact__field">
          </div>
          <div>
            <label class="kracht-contact__label" for="kc-lname">Achternaam*</label>
            <input id="kc-lname" type="text" name="contact[achternaam]" required class="kracht-contact__field">
          </div>
        </div>

        <div class="kracht-contact__row">
          <div>
            <label class="kracht-contact__label" for="kc-email">E-mailadres*</label>
            <input id="kc-email" type="email" name="contact[email]" required class="kracht-contact__field">
          </div>
          <div>
            <label class="kracht-contact__label" for="kc-phone">Telefoonnummer*</label>
            <input id="kc-phone" type="tel" name="contact[telefoonnummer]" required class="kracht-contact__field">
          </div>
        </div>

        <label class="kracht-contact__label" for="kc-body">Bericht</label>
        <textarea id="kc-body" name="contact[body]" rows="5" class="kracht-contact__field"></textarea>

        <label class="kracht-contact__consent">
          <input type="checkbox" required>
          <span>Ik ga akkoord met de <a href="/pages/algemene-voorwaarden">algemene voorwaarden</a> en <a href="/pages/privacybeleid">privacy policy</a>*</span>
        </label>

        <button type="submit" class="kracht-btn kracht-btn--primary kracht-contact__submit">{{ section.settings.submit_label }}</button>
      {%- endform -%}
    </div>

    <aside class="kracht-contact__aside">
      <p class="kracht-contact__aside-heading">{{ section.settings.aside_heading }}</p>
      <div class="kracht-contact__card">
        {%- if section.settings.contact_image != blank -%}
          <img src="{{ section.settings.contact_image | image_url: width: 400 }}" alt="{{ section.settings.contact_name }}" class="kracht-contact__card-img" loading="lazy">
        {%- endif -%}
        <div class="kracht-contact__card-body">
          <p class="kracht-contact__card-name">{{ section.settings.contact_name }}</p>
          {%- if section.settings.contact_phone != blank -%}
            <a href="tel:{{ section.settings.contact_phone | remove: ' ' }}" class="kracht-contact__card-link">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {{ section.settings.contact_phone }}
            </a>
          {%- endif -%}
          {%- if section.settings.contact_whatsapp != blank -%}
            <a href="https://wa.me/{{ section.settings.contact_whatsapp | remove: ' ' | remove: '+' | replace_first: '06', '316' }}" class="kracht-contact__card-link" target="_blank" rel="noopener">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              {{ section.settings.contact_whatsapp }}
            </a>
          {%- endif -%}
          {%- if section.settings.contact_email != blank -%}
            <a href="mailto:{{ section.settings.contact_email }}" class="kracht-contact__card-link">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              {{ section.settings.contact_email }}
            </a>
          {%- endif -%}
          <a class="kracht-btn kracht-btn--primary kracht-contact__card-cta" href="mailto:{{ section.settings.contact_email }}">Meer informatie</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .kracht-contact {
    background: #f7f7f8;
    color: var(--kracht-zwart, #000);
    padding-block: var(--kc-pad-y, 64px);
    font-family: var(--kracht-font-body);
  }
  .kracht-contact__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .kracht-contact__title {
    font-family: var(--kracht-font-heading);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }
  .kracht-contact__intro { margin: 0 0 1.5rem; color: #555; max-width: 30rem; }
  .kracht-contact__label { display: block; font-size: 0.85rem; margin: 1rem 0 0.3rem; color: #333; }
  .kracht-contact__field {
    width: 100%;
    border: 1px solid #dcdce0;
    border-radius: 6px;
    background: #fff;
    padding: 0.65rem 0.8rem;
    font: inherit;
    color: inherit;
  }
  .kracht-contact__field:focus { outline: 2px solid var(--kracht-blauw, #009de1); outline-offset: 0; border-color: transparent; }
  .kracht-contact__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .kracht-contact__consent { display: flex; gap: 0.5rem; align-items: flex-start; margin: 1.1rem 0 1.25rem; font-size: 0.85rem; color: #444; }
  .kracht-contact__consent a { color: inherit; text-decoration: underline; }
  .kracht-contact__consent input { margin-top: 0.2rem; accent-color: var(--kracht-blauw, #009de1); }
  .kracht-contact__submit { margin-left: auto; display: flex; }
  .kracht-contact__success { background: #e8f8ef; border-radius: 8px; padding: 0.8rem 1rem; color: #14683b; }
  .kracht-contact__error { background: #fdeeee; border-radius: 8px; padding: 0.8rem 1rem; color: #8f2020; }
  .kracht-contact__aside-heading { font-family: var(--kracht-font-heading); font-weight: 700; margin: 0 0 0.9rem; }
  .kracht-contact__card {
    background: #fff;
    border-radius: 10px;
    padding: 0;
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 1.1rem;
    align-items: stretch;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.05);
  }
  .kracht-contact__card-img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; display: block; }
  .kracht-contact__card-body { padding: 1.1rem 1.1rem 1.1rem 0; }
  .kracht-contact__card-name { font-family: var(--kracht-font-heading); font-weight: 700; margin: 0 0 0.5rem; }
  .kracht-contact__card-link { display: flex; align-items: center; gap: 0.4rem; color: #444; font-size: 0.85rem; text-decoration: underline; margin-bottom: 0.35rem; }
  .kracht-contact__card-link:hover { color: var(--kracht-blauw, #009de1); }
  .kracht-contact__card-cta { margin-top: 0.75rem; font-size: 0.85rem; padding: 8px 14px; }
  @media (max-width: 800px) {
    .kracht-contact__inner { grid-template-columns: 1fr; }
    .kracht-contact__row { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Kracht — Contactform",
  "tag": "section",
  "class": "kracht-contact-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meer informatie aanvragen" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Is jouw interesse gewekt of heb je graag wat meer informatie? Dat kan! Vul dan onderstaand formulier in." },
    { "type": "text", "id": "categories", "label": "Categorieën (komma-gescheiden)", "default": "Communicatie, Samenwerken, Leiderschap, Workcation" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Aanmelden" },
    { "type": "header", "content": "Contactpersoon" },
    { "type": "text", "id": "aside_heading", "label": "Aside heading", "default": "Meer weten over Kracht Training? Ik help je graag verder." },
    { "type": "image_picker", "id": "contact_image", "label": "Foto" },
    { "type": "text", "id": "contact_name", "label": "Naam", "default": "Koen de Bruijn" },
    { "type": "text", "id": "contact_phone", "label": "Telefoon", "default": "06 29 34 91 21" },
    { "type": "text", "id": "contact_whatsapp", "label": "WhatsApp", "default": "06 29 34 91 21" },
    { "type": "text", "id": "contact_email", "label": "E-mail", "default": "koen@vanuitkracht.nl" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 120, "step": 8, "default": 64 }
  ],
  "presets": [ { "name": "Kracht — Contactform" } ]
}
{% endschema %}
