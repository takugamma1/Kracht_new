{%- comment -%} Kracht — branded 404 page {%- endcomment -%}

<section class="kracht-404" style="--k404-pad-y: {{ section.settings.padding_y }}px;">
  <div class="kracht-container kracht-404__inner">
    <p class="kracht-404__code" aria-hidden="true">
      4<span class="kracht-404__plus">{% render 'kracht-plus' %}</span>4
    </p>
    <h1 class="kracht-404__title">{{ section.settings.heading }}</h1>
    <p class="kracht-404__text">{{ section.settings.text }}</p>
    <div class="kracht-404__actions">
      <a class="kracht-btn kracht-btn--primary" href="{{ routes.root_url }}">
        {{ section.settings.button1_label }} <span class="kracht-btn__arrow">→</span>
      </a>
      {%- if section.settings.button2_label != blank -%}
        <a class="kracht-btn kracht-btn--dark" href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .kracht-404 {
    background: #ffffff;
    color: var(--kracht-zwart, #000);
    padding-block: var(--k404-pad-y, 96px);
    font-family: var(--kracht-font-body);
    text-align: center;
  }
  .kracht-404__code {
    font-family: var(--kracht-font-heading);
    font-weight: 700;
    font-size: clamp(6rem, 18vw, 12rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.05em;
  }
  .kracht-404__plus { display: inline-flex; align-items: center; color: var(--kracht-blauw, #009de1); }
  .kracht-404__plus svg { width: 0.72em; height: 0.72em; }
  .kracht-404__title {
    font-family: var(--kracht-font-heading);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
  }
  .kracht-404__text {
    max-width: 34rem;
    margin: 0 auto 1.75rem;
    color: #444;
    line-height: 1.6;
  }
  .kracht-404__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

{% schema %}
{
  "name": "Kracht — 404",
  "tag": "section",
  "class": "kracht-404-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pagina niet gevonden"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "De pagina die je zoekt bestaat niet (meer) of is verplaatst. Geen zorgen — via de homepagina vind je snel je weg terug."
    },
    {
      "type": "text",
      "id": "button1_label",
      "label": "Primary button label (naar home)",
      "default": "Terug naar de homepagina"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Secondary button label",
      "default": "Bekijk de collectie"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    { "name": "Kracht — 404" }
  ]
}
{% endschema %}
